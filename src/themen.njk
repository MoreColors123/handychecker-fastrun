---
pagination:
  data: topics
  size: 1
  alias: topic
permalink: "/themen/{{ topic.slug }}/index.html"
eleventyComputed:
  title: "{{ topic.title | safe }}"
  suffixTitle: true
---
<!DOCTYPE html>
<html lang="{{ site.lang }}">
<head>
  {% include "head.njk" %}
</head>
<body>
  <header>
    <a class="skip" href="#inhalt">Zum Inhalt</a>
    <nav aria-label="Seitennavigation">
      <a class="back" href="{{ '/' | url }}">‹ Start</a>
    </nav>
  </header>
  <main id="inhalt" data-topic="{{ topic.slug }}">
    <div class="topic-happi">{% include "happi.njk" %}</div>
    <h1>{{ topic.title }}</h1>
    <p class="intro">{{ topic.intro }}</p>

    {% for fact in topic.facts %}
    <section class="fact">
      <h2>{{ fact.heading }}</h2>
      <p>{{ fact.text }}</p>
    </section>
    {% endfor %}

    <section class="balance">
      <h2>{{ topic.balance.heading }}</h2>
      <p>{{ topic.balance.text }}</p>
    </section>

    <section class="check-cta">
      <h2>Wie ist das bei dir?</h2>
      <p>Finde es heraus – ohne richtig oder falsch, nur für dich.</p>
      <p><a class="card card--start" href="{{ ('/themen/' + topic.slug + '/check/') | url }}">▶ Los geht's</a></p>
    </section>
  </main>
  <script src="{{ '/js/app.js' | url }}?v=5" defer></script>
  {% include "footer.njk" %}
</body>
</html>
