---
pagination:
  data: topics
  size: 1
  alias: topic
permalink: "/themen/{{ topic.slug }}/index.html"
eleventyComputed:
  title: "{{ topic.title | safe }}"
  suffixTitle: true
---
<!DOCTYPE html>
<html lang="{{ site.lang }}">
<head>
  {% include "head.njk" %}
</head>
<body>
  <header>
    <a class="skip" href="#inhalt">Zum Inhalt</a>
    <nav aria-label="Seitennavigation">
      <a class="back" href="{{ '/' | url }}">‹ Start</a>
    </nav>
  </header>
  <main id="inhalt">
    <div class="topic-happi">{% include "happi.njk" %}</div>
    <h1>{{ topic.title }}</h1>
    <p class="intro">{{ topic.intro }}</p>

    {% for fact in topic.facts %}
    <section class="fact">
      <h2>{{ fact.heading }}</h2>
      <p>{{ fact.text }}</p>
    </section>
    {% endfor %}

    <section class="balance">
      <h2>{{ topic.balance.heading }}</h2>
      <p>{{ topic.balance.text }}</p>
    </section>

    <section class="selfcheck">
      <h2>Wie ist das bei dir?</h2>
      <fieldset>
        <legend>{{ topic.selfCheck.question }}</legend>
        {% for opt in topic.selfCheck.options %}
        <div class="selfcheck-option">
          <input type="radio" name="sc-{{ topic.slug }}" id="sc-{{ topic.slug }}-{{ loop.index }}">
          <label for="sc-{{ topic.slug }}-{{ loop.index }}">{{ opt.emoji }} {{ opt.label }}</label>
          <p class="selfcheck-reflection">{{ opt.reflection }}</p>
        </div>
        {% endfor %}
      </fieldset>
      <p class="selfcheck-note">Deine Antwort wird nicht gespeichert und nicht gesendet.</p>
    </section>

    <section class="tips">
      <h2>Was kann ich tun?</h2>
      <ul>
        {% for tip in topic.tips %}<li>{{ tip }}</li>{% endfor %}
      </ul>
    </section>

    <section class="next">
      <h2>Weiter geht's</h2>
      <ul class="topic-cards">
        {% for t in topics %}{% if t.slug in topic.next %}
        <li><a class="card" href="{{ ('/themen/' + t.slug + '/') | url }}">{{ t.title }}</a></li>
        {% endif %}{% endfor %}
      </ul>
    </section>
  </main>
  {% include "footer.njk" %}
</body>
</html>
